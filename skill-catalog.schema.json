{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MODH public skill metadata",
  "type": "object",
  "required": ["generated_at", "skills"],
  "properties": {
    "generated_at": { "type": "string", "format": "date" },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "tier": { "type": "string" },
          "icon": { "type": "string" },
          "title": { "type": "string" },
          "seo_title": { "type": "string" },
          "seo_description": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "string" },
          "related_chapters": { "type": "array", "items": { "type": "string" } },
          "related_tools": { "type": "array", "items": { "type": "string" } },
          "allowed-tools": {}
        },
        "additionalProperties": true
      }
    }
  }
}
